---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const resumenes = await getCollection('resumenes');
  return resumenes.map((r) => ({
    params: { id: r.id },
    props: { r },
  }));
}

const { r } = Astro.props;
const { Content } = await render(r);

const formatoFecha = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---
<Base titulo={r.data.titulo}>
  <p><a href="/">&larr; Todos los resúmenes</a></p>
  <article>
    <h1>{r.data.titulo}</h1>
    <p class="fecha">{formatoFecha.format(r.data.fecha)} · Semana del {r.data.semana}</p>
    <Content />
  </article>
</Base>
