---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const resumenes = (await getCollection('resumenes')).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime()
);

const formatoFecha = new Intl.DateTimeFormat('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const total = resumenes.length;
const ultimaFecha = resumenes[0] ? formatoFecha.format(resumenes[0].data.fecha) : '';
---
<Base titulo="Inicio">
  <header class="masthead">
    <p class="kicker">El resumen dominical</p>
    <h1>Newsletter Digest</h1>
    <p class="lema">Lo mejor de las newsletters de Alberto, cada semana: frases, ideas y apuntes que merecen quedarse.</p>
  </header>
  <div class="datos">
    <span>{total} {total === 1 ? 'resumen' : 'resúmenes'}</span>
    {ultimaFecha && <span>Actualizado el {ultimaFecha}</span>}
  </div>
  <ol class="entradas">
    {resumenes.map((r, i) => (
      <li class="entrada">
        <a href={`/resumen/${r.id}/`}>
          <span class="num">{String(total - i).padStart(2, '0')}</span>
          <span>
            <span class="meta">{formatoFecha.format(r.data.fecha)} · {r.data.semana}</span>
            <span class="titulo">{r.data.titulo}</span>
            <span class="leer">Leer el resumen &rarr;</span>
          </span>
        </a>
      </li>
    ))}
  </ol>
</Base>
